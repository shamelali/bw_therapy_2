# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign JWT session tokens. Must be a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-secret

# Set to true when NODE_ENV === "production" to enable secure cookies.
# (managed automatically by the app)
